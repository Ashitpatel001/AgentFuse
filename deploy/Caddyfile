# ═══════════════════════════════════════════════════════════
# CortexHeal — Caddy Reverse Proxy Configuration
# ═══════════════════════════════════════════════════════════
# Place this file at /etc/caddy/Caddyfile on the host.
# Caddy will automatically provision Let's Encrypt TLS certs
# as long as DNS A-records for these domains point to the server.
#
# Replace YOURDOMAIN.com globally before reloading Caddy!
# ═══════════════════════════════════════════════════════════

# ── OPTION A: Unified Single-Domain Deployment (Recommended) ─────────
YOURDOMAIN.com, www.YOURDOMAIN.com {
    # 1. AI Circuit Breaker Proxy Gateway (Zero-Code OpenAI/Anthropic Drop-in)
    handle /v1/* {
        reverse_proxy 127.0.0.1:8000
    }

    # 2. Control Plane REST API
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    # 3. Health & Uptime Probe
    handle /health {
        reverse_proxy 127.0.0.1:8000
    }

    # 4. Real-Time Telemetry SSE Stream (Unbuffered)
    handle /api/stream* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # 5. Dashboard SPA (/dashboard)
    handle /dashboard* {
        root * /opt/cortexheal/app/frontend/dist
        uri strip_prefix /dashboard
        try_files {path} /index.html
        file_server
    }

    # 6. Public Marketing & Safety Docs Site (Catch-all)
    root * /opt/cortexheal/app/site/dist
    try_files {path} /index.html
    file_server

    encode gzip zstd
}

# ── OPTION B: Dedicated Subdomain Architecture ───────────────────────
# (Uncomment below if using api.YOURDOMAIN.com and app.YOURDOMAIN.com)
#
# api.YOURDOMAIN.com {
#     reverse_proxy 127.0.0.1:8000 {
#         flush_interval -1
#     }
# }
